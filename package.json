{
  "name": "dsh-credit-history",
  "version": "1.0.0",
  "description": "独立的积分历史插件：后台低频采样、独立走势图页面，不修改 Jet Hub 手动查询。",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./client.js", "./package.json": "./package.json" },
  "files": ["lib", "client.js", "cordis.patch.yml", "README.md"],
  "scripts": { "build:client": "node build-client.mjs", "test": "node --test tests/*.test.mjs" },
  "devDependencies": { "esbuild": "^0.24.2" },
  "engines": { "node": ">=22" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["dsh-better-sidebar"] }
  }
}
